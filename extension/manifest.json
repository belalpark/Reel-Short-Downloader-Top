{
  "manifest_version": 3,
  "name": "Reel Short Downloader Top \u2014 Scanner v5.4.2",
  "version": "5.4.2",
  "description": "Collects accessible episode sources with verified playback and HLS segment matching.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://www.reelshort.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.reelshort.com/*"
      ],
      "js": [
        "hls_observer.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.reelshort.com/*"
      ],
      "js": [
        "scanner_core.js",
        "playback_probe.js",
        "hls_source.js",
        "retry_plan.js",
        "page_agent.js",
        "desktop_poll.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drama Series Scanner"
  },
  "background": {
    "service_worker": "background.js"
  }
}
